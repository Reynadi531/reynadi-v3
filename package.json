{
  "name": "reynad-v3",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @reynad-v3/db --",
    "db:studio": "turbo run db:studio -F @reynad-v3/db --",
    "db:generate": "turbo run db:generate -F @reynad-v3/db --",
    "db:migrate": "turbo run db:migrate -F @reynad-v3/db --",
    "db:start": "turbo run db:start -F @reynad-v3/db --",
    "db:watch": "turbo run db:watch -F @reynad-v3/db --",
    "db:stop": "turbo run db:stop -F @reynad-v3/db --",
    "db:down": "turbo run db:down -F @reynad-v3/db --",
    "deploy:setup": "bunx vercel link",
    "dev:vercel": "bunx vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "bunx vercel deploy",
    "deploy:prod": "bunx vercel deploy --prod",
    "deploy:check": "bunx vercel deploy --dry",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reynad-v3/config": "workspace:*",
    "@types/node": "^26.4.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.13",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.3"
}
