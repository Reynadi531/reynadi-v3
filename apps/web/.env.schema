# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# Cloudflare Turnstile. Sitekey is public (shipped to the browser); the secret stays on the server.
# Dev uses Cloudflare's always-pass test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# @public @type=string(minLength=1)
TURNSTILE_SITE_KEY=

# @type=string(minLength=1)
TURNSTILE_SECRET_KEY=

# Formspree endpoint that receives contact form submissions, e.g. https://formspree.io/f/abcdwxyz.
# Server only: Turnstile is verified here before anything is forwarded, so leave Turnstile off in
# the Formspree form settings (it would try to verify the already-used token a second time).
# @type=url
FORMSPREE_URL=
